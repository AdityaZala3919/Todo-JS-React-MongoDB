# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/TaskFlowTodo?retryWrites=true&w=majority
MONGODB_DB=TaskFlowTodo

# Fast-Path Static Users via JSON string (Instant Login, Bypasses MongoDB connect)
# Note: Use your existing MongoDB user ID for the "id" field so your tasks/projects sync properly.
PRECONFIGURED_USERS=[{"id":"your-mongodb-user-id","email":"user@example.com","password_hash":"$2a$10$YourBcryptHash","display_name":"Aditya"}]

